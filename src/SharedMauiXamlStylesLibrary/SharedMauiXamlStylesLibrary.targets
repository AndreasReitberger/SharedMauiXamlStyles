<?xml version="1.0" encoding="utf-8"?>
<Project>
	<!--<Import Project="$(MSBuildThisFileDirectory)PackMauiAssets.targets" Condition="Exists('$(MSBuildThisFileDirectory)PackMauiAssets.targets')" />-->
  <Import Project="$(MSBuildThisFileDirectory)Fonts.props" Condition="Exists('$(MSBuildThisFileDirectory)Fonts.props')" />

  <!-- Clear source-relative paths and redefine with package-relative paths -->
  <ItemGroup>
    <FontDefinition Remove="@(FontDefinition)" />
  </ItemGroup>

  <ItemGroup>
    <FontDefinition Include="$(MSBuildThisFileDirectory)Fonts/Montserrat-Bold.ttf">
      <FontAlias>MontserratBold</FontAlias>
    </FontDefinition>
    <FontDefinition Include="$(MSBuildThisFileDirectory)Fonts/Montserrat-Medium.ttf">
      <FontAlias>MontserratMedium</FontAlias>
    </FontDefinition>
    <FontDefinition Include="$(MSBuildThisFileDirectory)Fonts/Montserrat-Regular.ttf">
      <FontAlias>MontserratRegular</FontAlias>
    </FontDefinition>
    <FontDefinition Include="$(MSBuildThisFileDirectory)Fonts/Montserrat-SemiBold.ttf">
      <FontAlias>MontserratSemiBold</FontAlias>
    </FontDefinition>
  </ItemGroup>
  
  <ItemGroup>
    <MauiFont Include="@(FontDefinition)" Alias="%(FontDefinition.FontAlias)" />
  </ItemGroup>

  <!-- Set the correct build action for font files 
  <ItemGroup>
    <MauiFont Include="$(MSBuildThisFileDirectory)..\buildTransitive\_MauiItems\Fonts\materialdesignicons-webfont.ttf">
      <Link>Resources\Fonts\materialdesignicons-webfont.ttf</Link>
    </MauiFont>
    <MauiFont Include="$(MSBuildThisFileDirectory)..\buildTransitive\_MauiItems\Fonts\Montserrat-Bold.ttf">
      <Link>Resources\Fonts\Montserrat-Bold.ttf</Link>
    </MauiFont>
    <MauiFont Include="$(MSBuildThisFileDirectory)..\buildTransitive\_MauiItems\Fonts\Montserrat-Medium.ttf">
      <Link>Resources\Fonts\Montserrat-Medium.ttf</Link>
    </MauiFont>
    <MauiFont Include="$(MSBuildThisFileDirectory)..\buildTransitive\_MauiItems\Fonts\Montserrat-Regular.ttf">
      <Link>Resources\Fonts\Montserrat-Regular.ttf</Link>
    </MauiFont>
    <MauiFont Include="$(MSBuildThisFileDirectory)..\buildTransitive\_MauiItems\Fonts\Montserrat-SemiBold.ttf">
      <Link>Resources\Fonts\Montserrat-SemiBold.ttf</Link>
    </MauiFont>
  </ItemGroup>
  -->
</Project>